<!DOCTYPE html>
<html>

<head>
    <title>Login</title>
</head>

<body>

    <h1>Login</h1>

    <form action="/ui/login" method="POST">

        <div>
            <label>Email</label>

            <input type="email" name="email" required>
        </div>

        <br>

        <div>
            <label>Password</label>

            <input type="password" name="password" required>
        </div>

        <br>

        <button type="submit">
            Login
        </button>

    </form>

    <p>
        Don't have an account?
        <a href="/ui/signup">
            Signup
        </a>
    </p>

    <% if (error) { %>

        <p style="color:red">
            <%= error %>
        </p>

        <% } %>

</body>

</html>