<%- include("../partials/header", { title: "Create Label" }) %>

    <%- include("../partials/navbar") %>

        <main class="container page-content">

            <div class="page-header">

                <div>

                    <h1>
                        Create Label
                    </h1>

                    <p>
                        Add a custom tag to your tasks.
                    </p>

                </div>

                <a href="/ui/labels" class="btn btn-secondary">
                    Back
                </a>

            </div>

            <div class="card form-card">

                <% if (error) { %>

                    <div class="alert alert-danger">
                        <%= error %>
                    </div>

                    <% } %>

                        <form action="/ui/labels/create" method="POST" class="form">

                            <div class="form-group">

                                <label>
                                    Label Name
                                </label>

                                <input type="text" name="name" placeholder="e.g. Urgent" required>

                            </div>

                            <div class="form-actions">

                                <a href="/ui/labels" class="btn btn-secondary">
                                    Cancel
                                </a>

                                <button type="submit" class="btn btn-primary">
                                    Create Label
                                </button>

                            </div>

                        </form>

            </div>

        </main>

        <%- include("../partials/footer") %>