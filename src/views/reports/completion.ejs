<%- include("../partials/header", { title: "Completion Over Time" }) %>

    <%- include("../partials/navbar") %>

        <main class="container page-content">

            <div class="page-header">

                <div>

                    <h1>
                        Completion Over Time
                    </h1>

                    <p>
                        Track your task completion rate.
                    </p>

                </div>

                <a href="/ui/reports/statistics" class="btn btn-secondary">
                    Statistics
                </a>

            </div>

            <div class="card">

                <form action="/ui/reports/completion" method="GET" class="filter-form">

                    <div class="form-group">

                        <label>
                            Start Date
                        </label>

                        <input type="date" name="startDate" value="<%= startDate || '' %>" required>

                    </div>

                    <div class="form-group">

                        <label>
                            End Date
                        </label>

                        <input type="date" name="endDate" value="<%= endDate || '' %>" required>

                    </div>

                    <button type="submit" class="btn btn-primary">
                        Generate
                    </button>

                </form>

            </div>

            <br>

            <% if (statistics.length===0) { %>

                <div class="empty-state">

                    <h2>
                        No data available
                    </h2>

                    <p>
                        There are no tasks for the selected period.
                    </p>

                </div>

                <% } else { %>

                    <div class="table-container">

                        <table>

                            <thead>

                                <tr>

                                    <th>
                                        Date
                                    </th>

                                    <th>
                                        Total Tasks
                                    </th>

                                    <th>
                                        Completed
                                    </th>

                                    <th>
                                        Completion Rate
                                    </th>

                                </tr>

                            </thead>

                            <tbody>

                                <% statistics.forEach(item=> { %>

                                    <tr>

                                        <td>
                                            <%= item.date %>
                                        </td>

                                        <td>
                                            <%= item.totalTasks %>
                                        </td>

                                        <td>
                                            <%= item.completedTasks %>
                                        </td>

                                        <td>

                                            <div class="progress-wrapper">

                                                <div class="progress">

                                                    <div class="progress-bar" style="--completion-rate: <%= item.completionRate %>%">
                                                    </div>

                                                </div>

                                                <span>
                                                    <%= item.completionRate.toFixed(1) %>%
                                                </span>

                                            </div>

                                        </td>

                                    </tr>

                                    <% }) %>

                            </tbody>

                        </table>

                    </div>

                    <% } %>

        </main>

        <%- include("../partials/footer") %>