<%- include("../partials/header", { title: "Task Details" }) %>

    <%- include("../partials/navbar") %>

        <main class="container">

            <div class="page-header">
                <div>
                    <h1>Task Details</h1>
                    <p>View complete information about this task.</p>
                </div>

                <div class="page-actions">
                    <a href="/ui/tasks" class="btn btn-secondary">
                        Back
                    </a>

                    <a href="/ui/tasks/edit/<%= task._id %>" class="btn btn-primary">
                        Edit Task
                    </a>
                </div>
            </div>


            <div class="card task-details">

                <div class="task-details-header">

                    <div>
                        <h2>
                            <%= task.title %>
                        </h2>

                        <% if (task.status==="Completed" ) { %>
                            <span class="badge badge-success">
                                Completed
                            </span>
                            <% } else { %>
                                <span class="badge badge-warning">
                                    Pending
                                </span>
                                <% } %>
                    </div>

                </div>


                <div class="task-details-grid">

                    <!-- Description -->
                    <div class="detail-item">
                        <span class="detail-label">
                            Description
                        </span>

                        <p>
                            <%= task.description || "No description available" %>
                        </p>
                    </div>


                    <!-- Priority -->
                    <div class="detail-item">
                        <span class="detail-label">
                            Priority
                        </span>

                        <p>
                            <%= task.priority || "Not specified" %>
                        </p>
                    </div>


                    <!-- Due Date -->
                    <div class="detail-item">
                        <span class="detail-label">
                            Due Date
                        </span>

                        <p>
                            <% if (task.dueDate) { %>
                                <%= new Date(task.dueDate).toLocaleDateString("en-IN") %>
                                    <% } else { %>
                                        No due date
                                        <% } %>
                        </p>
                    </div>


                    <!-- Category -->
                    <div class="detail-item">
                        <span class="detail-label">
                            Category
                        </span>

                        <p>
                            <% if (task.category) { %>
                                <%= task.category.name %>
                                    <% } else { %>
                                        No category
                                        <% } %>
                        </p>
                    </div>


                    <!-- Labels -->
                    <div class="detail-item">
                        <span class="detail-label">
                            Labels
                        </span>

                        <div class="task-labels">

                            <% if (task.labels && task.labels.length> 0) { %>

                                <% task.labels.forEach(label=> { %>

                                    <span class="badge badge-info">
                                        <%= label.name %>
                                    </span>

                                    <% }) %>

                                        <% } else { %>

                                            <span>
                                                No labels
                                            </span>

                                            <% } %>

                        </div>
                    </div>


                    <!-- Order -->
                    <div class="detail-item">
                        <span class="detail-label">
                            Order
                        </span>

                        <p>
                            <%= task.order ?? 0 %>
                        </p>
                    </div>


                    <!-- Created At -->
                    <div class="detail-item">
                        <span class="detail-label">
                            Created At
                        </span>

                        <p>
                            <% if (task.createdAt) { %>
                                <%= new Date(task.createdAt).toLocaleString("en-IN") %>
                                    <% } else { %>
                                        -
                                        <% } %>
                        </p>
                    </div>


                    <!-- Updated At -->
                    <div class="detail-item">
                        <span class="detail-label">
                            Updated At
                        </span>

                        <p>
                            <% if (task.updatedAt) { %>
                                <%= new Date(task.updatedAt).toLocaleString("en-IN") %>
                                    <% } else { %>
                                        -
                                        <% } %>
                        </p>
                    </div>


                    <!-- Completed At -->
                    <div class="detail-item">
                        <span class="detail-label">
                            Completed At
                        </span>

                        <p>
                            <% if (task.completedAt) { %>
                                <%= new Date(task.completedAt).toLocaleString("en-IN") %>
                                    <% } else { %>
                                        Not completed
                                        <% } %>
                        </p>
                    </div>

                </div>


                <!-- Actions -->
                <div class="task-details-actions">

                    <% if (task.status !=="Completed" ) { %>

                        <form action="/ui/tasks/complete/<%= task._id %>" method="POST">
                            <button type="submit" class="btn btn-success">
                                Mark as Completed
                            </button>
                        </form>

                        <% } %>


                            <a href="/ui/tasks/edit/<%= task._id %>" class="btn btn-primary">
                                Edit
                            </a>


                            <form action="/ui/tasks/delete/<%= task._id %>" method="POST"
                                onsubmit="return confirm('Are you sure you want to delete this task?');">
                                <button type="submit" class="btn btn-danger">
                                    Delete
                                </button>
                            </form>

                </div>

            </div>

        </main>

        <%- include("../partials/footer") %>