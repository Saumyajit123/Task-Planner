<%- include("../partials/header", { title: "Edit Category" }) %>

    <%- include("../partials/navbar") %>

        <main class="container page-content">

            <div class="page-header">

                <div>

                    <h1>
                        Edit Category
                    </h1>

                    <p>
                        Update your category.
                    </p>

                </div>

                <a href="/ui/categories" class="btn btn-secondary">
                    Back
                </a>

            </div>

            <div class="card form-card">

                <% if (error) { %>

                    <div class="alert alert-danger">
                        <%= error %>
                    </div>

                    <% } %>

                        <form action="/ui/categories/edit/<%= category._id %>" method="POST" class="form">

                            <div class="form-group">

                                <label>
                                    Category Name
                                </label>

                                <input type="text" name="name" value="<%= category.name %>" required>

                            </div>

                            <div class="form-group">

                                <label>
                                    Description
                                </label>

                                <textarea name="description" rows="5"><%= category.description %></textarea>

                            </div>

                            <div class="form-actions">

                                <a href="/ui/categories" class="btn btn-secondary">
                                    Cancel
                                </a>

                                <button type="submit" class="btn btn-primary">
                                    Update Category
                                </button>

                            </div>

                        </form>

            </div>

        </main>

        <%- include("../partials/footer") %>